config_version=5

[application]

config/name="Royaume"
config/icon="res://icon.png"
run/main_scene="res://scenes/royaume.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
run/max_fps=60

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
scaling_3d/mode=0
scaling_3d/scale=0.75
mesh_lod/lod_change/threshold_pixels=3.0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=0
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/positional_shadow/atlas_size=1024
limits/opengl/max_renderable_lights=16
shading/overrides/force_lambert_over_burley=true
environment/defaults/default_clear_color=Color(0.6, 0.75, 0.9, 1)
